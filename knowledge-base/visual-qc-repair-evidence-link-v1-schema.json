{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VISUAL-QC-REPAIR-EVIDENCE-LINK-V1",
  "$comment": "V1 linkability is reviewed_manual_four_point only; future automatic support requires an explicit contract with equivalent auditable correspondences. This schema enforces portable structure and collection bounds only. repair_evidence_link_contract.py is authoritative for canonical hashes, strict in-memory integers, homography determinant, board-domain denominator horizon, solve correspondence, independent error recomputation, projection validity, and cross-field geometry; Draft 2020-12 may treat an in-memory mathematically integral float as an integer. Persisted JSON must enter through the strict loader, which rejects nonfinite constants and lone Unicode surrogates. Prior-manifest revision increments, actual parent hashes, append-only preservation, and publisher-derived external truth require the Task 3 on-disk validator.",
  "title": "Visual QC Repair Evidence Link V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "link_set_id",
    "revision",
    "previous_manifest_sha256",
    "source_origin",
    "repair_case_references",
    "board",
    "physical_evidence",
    "bindings",
    "boundaries"
  ],
  "properties": {
    "schema_version": {"const": "VISUAL-QC-REPAIR-EVIDENCE-LINK-V1"},
    "link_set_id": {"$ref": "#/$defs/safeId"},
    "revision": {"type": "integer", "minimum": 1},
    "previous_manifest_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "source_origin": {"const": "codex_operator"},
    "repair_case_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/repairCaseReference"}
    },
    "board": {"$ref": "#/$defs/board"},
    "physical_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {"$ref": "#/$defs/physicalEvidence"}
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {"$ref": "#/$defs/binding"}
    },
    "boundaries": {"$ref": "#/$defs/fixedBoundaries"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"revision": {"const": 1}},
        "required": ["revision"]
      },
      "then": {
        "properties": {
          "previous_manifest_sha256": {"type": "null"},
          "bindings": {
            "items": {
              "properties": {"supersedes_binding_id": {"type": "null"}}
            }
          }
        }
      },
      "else": {
        "properties": {
          "previous_manifest_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*[\\\\<>:\"|?*])(?!.*[\\x00-\\x1F\\x7F-\\x9F])(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)[^/]*[ .](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])[ .]*(?:\\.[^/]*)?(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "fixedBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_defect_confirmed",
        "qc_annotation_created",
        "golden_approved",
        "training_label_allowed",
        "repair_causality_confirmed",
        "repair_instruction_allowed",
        "field_accuracy_claim_allowed"
      ],
      "properties": {
        "visual_defect_confirmed": {"const": false},
        "qc_annotation_created": {"const": false},
        "golden_approved": {"const": false},
        "training_label_allowed": {"const": false},
        "repair_causality_confirmed": {"const": false},
        "repair_instruction_allowed": {"const": false},
        "field_accuracy_claim_allowed": {"const": false}
      }
    },
    "bindingBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_defect_confirmed",
        "qc_annotation_created",
        "golden_approved",
        "training_label_allowed",
        "repair_causality_confirmed",
        "repair_instruction_allowed",
        "field_accuracy_claim_allowed",
        "model_identity_resolved"
      ],
      "properties": {
        "visual_defect_confirmed": {"const": false},
        "qc_annotation_created": {"const": false},
        "golden_approved": {"const": false},
        "training_label_allowed": {"const": false},
        "repair_causality_confirmed": {"const": false},
        "repair_instruction_allowed": {"const": false},
        "field_accuracy_claim_allowed": {"const": false},
        "model_identity_resolved": {"type": "boolean"}
      }
    },
    "repairCaseReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repair_case_reference_id",
        "repair_case_id",
        "revision",
        "schema_version",
        "manifest_sha256",
        "board_key",
        "board_id"
      ],
      "properties": {
        "repair_case_reference_id": {"$ref": "#/$defs/safeId"},
        "repair_case_id": {"$ref": "#/$defs/safeId"},
        "revision": {"type": "integer", "minimum": 1},
        "schema_version": {
          "enum": [
            "VISUAL-QC-REPAIR-CASE-SOURCE-V1",
            "VISUAL-QC-REPAIR-CASE-SOURCE-V2",
            "VISUAL-QC-REPAIR-CASE-SOURCE-V3"
          ]
        },
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "board_key": {"$ref": "#/$defs/safeId"},
        "board_id": {"$ref": "#/$defs/safeId"}
      }
    },
    "catalogAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "entry_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "entry_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "compiledSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {"$ref": "#/$defs/safeId"},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "board_key",
        "board_id",
        "catalog_asset",
        "compiled_sources",
        "board_snapshot_sha256"
      ],
      "properties": {
        "board_key": {"$ref": "#/$defs/safeId"},
        "board_id": {"$ref": "#/$defs/safeId"},
        "catalog_asset": {"$ref": "#/$defs/catalogAsset"},
        "compiled_sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/compiledSource"}
        },
        "board_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "entry_id"],
      "properties": {
        "batch_id": {"$ref": "#/$defs/safeId"},
        "entry_id": {"$ref": "#/$defs/safeId"}
      }
    },
    "qualifiedHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "handoff_schema_version",
        "source_package_manifest_sha256",
        "archived_intake_manifest_sha256",
        "acceptance_report_sha256",
        "acceptance_action",
        "registration_review_required",
        "field_accuracy_claim_allowed"
      ],
      "properties": {
        "schema_version": {
          "const": "VISUAL-QC-QUALIFIED-HANDOFF-PROVENANCE-V1"
        },
        "handoff_schema_version": {
          "const": "VISUAL-QC-PHYSICAL-HANDOFF-V1"
        },
        "source_package_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "archived_intake_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "acceptance_report_sha256": {"$ref": "#/$defs/sha256"},
        "acceptance_action": {
          "enum": [
            "automatic_candidate_review_required",
            "manual_registration_required"
          ]
        },
        "registration_review_required": {"const": true},
        "field_accuracy_claim_allowed": {"const": false}
      }
    },
    "normalizedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "registrationPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board", "image"],
      "properties": {
        "board": {"$ref": "#/$defs/normalizedPoint"},
        "image": {"$ref": "#/$defs/normalizedPoint"}
      }
    },
    "registrationError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "rms", "maximum"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "rms": {"type": "number", "minimum": 0},
        "maximum": {"type": "number", "minimum": 0}
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "board_to_image_matrix",
        "solve_anchors",
        "independent_check_points",
        "error"
      ],
      "properties": {
        "method": {
          "enum": [
            "reviewed_manual_four_point"
          ]
        },
        "board_to_image_matrix": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {"type": "number"}
        },
        "solve_anchors": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/registrationPoint"}
        },
        "independent_check_points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/registrationPoint"}
        },
        "error": {"$ref": "#/$defs/registrationError"}
      }
    },
    "physicalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "physical_evidence_id",
        "server_case_id",
        "intake",
        "board_key",
        "board_id",
        "side_id",
        "capture_stage",
        "evidence_role",
        "qualified_handoff",
        "qualified_handoff_sha256",
        "image_id",
        "image_sha256",
        "job_id",
        "registration_review_id",
        "registration",
        "physical_evidence_snapshot_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "VISUAL-QC-LINKABLE-PHYSICAL-EVIDENCE-V1"
        },
        "physical_evidence_id": {"$ref": "#/$defs/safeId"},
        "server_case_id": {"$ref": "#/$defs/safeId"},
        "intake": {"$ref": "#/$defs/intake"},
        "board_key": {"$ref": "#/$defs/safeId"},
        "board_id": {"$ref": "#/$defs/safeId"},
        "side_id": {"$ref": "#/$defs/safeId"},
        "capture_stage": {"$ref": "#/$defs/safeId"},
        "evidence_role": {"const": "physical_capture"},
        "qualified_handoff": {"$ref": "#/$defs/qualifiedHandoff"},
        "qualified_handoff_sha256": {"$ref": "#/$defs/sha256"},
        "image_id": {"$ref": "#/$defs/safeId"},
        "image_sha256": {"$ref": "#/$defs/sha256"},
        "job_id": {"$ref": "#/$defs/safeId"},
        "registration_review_id": {"$ref": "#/$defs/safeId"},
        "registration": {"$ref": "#/$defs/registration"},
        "physical_evidence_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "claim_status"],
      "properties": {
        "text": {"$ref": "#/$defs/nonEmptyString"},
        "claim_status": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["reported", "suspected", "documented"]}
          ]
        }
      }
    },
    "sourceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fact_id", "display", "fact_sha256"],
      "properties": {
        "kind": {
          "enum": [
            "reported_symptom",
            "finding",
            "repair_action",
            "outcome"
          ]
        },
        "fact_id": {"$ref": "#/$defs/safeId"},
        "display": {"$ref": "#/$defs/display"},
        "fact_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "finding"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "display": {
                "properties": {
                  "claim_status": {
                    "enum": ["reported", "suspected", "documented"]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "display": {
                "properties": {"claim_status": {"type": "null"}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {"kind": {"const": "outcome"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {"fact_id": {"const": "outcome"}}
          }
        }
      ]
    },
    "normalizedRectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "x", "y", "width", "height"],
      "properties": {
        "kind": {"const": "normalized_rectangle"},
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "normalizedPolygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "points"],
      "properties": {
        "kind": {"const": "normalized_polygon"},
        "points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/normalizedPoint"}
        }
      }
    },
    "pointLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "point"],
      "properties": {
        "kind": {"const": "normalized_point"},
        "point": {"$ref": "#/$defs/normalizedPoint"}
      }
    },
    "footprintRectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "footprintLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rectangle"],
      "properties": {
        "kind": {"const": "normalized_footprint"},
        "rectangle": {"$ref": "#/$defs/footprintRectangle"}
      }
    },
    "engineering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "designator",
        "technician_category",
        "location",
        "evidence_descriptors",
        "geometry_source_status",
        "semantic_identity_proven",
        "engineering_snapshot_sha256"
      ],
      "properties": {
        "component_id": {"$ref": "#/$defs/safeId"},
        "designator": {"$ref": "#/$defs/safeId"},
        "technician_category": {"$ref": "#/$defs/safeId"},
        "location": {
          "oneOf": [
            {"$ref": "#/$defs/pointLocation"},
            {"$ref": "#/$defs/footprintLocation"}
          ]
        },
        "evidence_descriptors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "geometry_source_status": {"enum": ["high", "medium", "low"]},
        "semantic_identity_proven": {"type": "boolean"},
        "engineering_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"geometry_source_status": {"const": "low"}},
            "required": ["geometry_source_status"]
          },
          "then": {
            "properties": {"location": {"$ref": "#/$defs/pointLocation"}}
          }
        }
      ]
    },
    "wholeBoardTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "side_id"],
      "properties": {
        "kind": {"const": "whole_board"},
        "side_id": {"$ref": "#/$defs/safeId"}
      }
    },
    "boardRegionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "side_id", "region"],
      "properties": {
        "kind": {"const": "board_region"},
        "side_id": {"$ref": "#/$defs/safeId"},
        "region": {
          "oneOf": [
            {"$ref": "#/$defs/normalizedRectangle"},
            {"$ref": "#/$defs/normalizedPolygon"}
          ]
        }
      }
    },
    "designatorTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "side_id", "engineering"],
      "properties": {
        "kind": {"const": "designator"},
        "side_id": {"$ref": "#/$defs/safeId"},
        "engineering": {"$ref": "#/$defs/engineering"}
      }
    },
    "target": {
      "oneOf": [
        {"$ref": "#/$defs/wholeBoardTarget"},
        {"$ref": "#/$defs/boardRegionTarget"},
        {"$ref": "#/$defs/designatorTarget"}
      ]
    },
    "repairCaseFactBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {"kind": {"const": "repair_case_fact"}}
    },
    "engineeringIdentityBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {"kind": {"const": "engineering_identity"}}
    },
    "humanObservationBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observation_code"],
      "properties": {
        "kind": {"const": "human_observation"},
        "observation_code": {
          "enum": [
            "target_visible",
            "target_not_visible",
            "target_occluded"
          ]
        }
      }
    },
    "evidenceBasis": {
      "oneOf": [
        {"$ref": "#/$defs/repairCaseFactBasis"},
        {"$ref": "#/$defs/engineeringIdentityBasis"},
        {"$ref": "#/$defs/humanObservationBasis"}
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "repair_case_reference_id",
        "source_fact",
        "target",
        "physical_evidence_id",
        "association_status",
        "visibility_status",
        "evidence_bases",
        "supersedes_binding_id",
        "boundaries"
      ],
      "properties": {
        "binding_id": {"$ref": "#/$defs/safeId"},
        "repair_case_reference_id": {"$ref": "#/$defs/safeId"},
        "source_fact": {"$ref": "#/$defs/sourceFact"},
        "target": {"$ref": "#/$defs/target"},
        "physical_evidence_id": {"$ref": "#/$defs/safeId"},
        "association_status": {
          "enum": [
            "related",
            "possibly_related",
            "not_related",
            "insufficient_evidence"
          ]
        },
        "visibility_status": {
          "enum": [
            "not_assessed",
            "visible",
            "not_visible",
            "occluded"
          ]
        },
        "evidence_bases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceBasis"}
        },
        "supersedes_binding_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/safeId"}
          ]
        },
        "boundaries": {"$ref": "#/$defs/bindingBoundaries"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "association_status": {"const": "related"},
              "target": {
                "properties": {"kind": {"const": "designator"}},
                "required": ["kind"]
              }
            },
            "required": ["association_status", "target"]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "engineering": {
                    "properties": {
                      "semantic_identity_proven": {"const": true}
                    }
                  }
                }
              },
              "evidence_bases": {
                "allOf": [
                  {
                    "contains": {
                      "properties": {"kind": {"const": "repair_case_fact"}},
                      "required": ["kind"]
                    }
                  },
                  {
                    "contains": {
                      "properties": {"kind": {"const": "engineering_identity"}},
                      "required": ["kind"]
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {"visibility_status": {"const": "visible"}},
            "required": ["visibility_status"]
          },
          "then": {
            "properties": {
              "evidence_bases": {
                "items": {
                  "if": {
                    "properties": {"kind": {"const": "human_observation"}},
                    "required": ["kind"]
                  },
                  "then": {
                    "properties": {
                      "observation_code": {"const": "target_visible"}
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"visibility_status": {"const": "not_visible"}},
            "required": ["visibility_status"]
          },
          "then": {
            "properties": {
              "evidence_bases": {
                "items": {
                  "if": {
                    "properties": {"kind": {"const": "human_observation"}},
                    "required": ["kind"]
                  },
                  "then": {
                    "properties": {
                      "observation_code": {"const": "target_not_visible"}
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"visibility_status": {"const": "occluded"}},
            "required": ["visibility_status"]
          },
          "then": {
            "properties": {
              "evidence_bases": {
                "items": {
                  "if": {
                    "properties": {"kind": {"const": "human_observation"}},
                    "required": ["kind"]
                  },
                  "then": {
                    "properties": {
                      "observation_code": {"const": "target_occluded"}
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"visibility_status": {"const": "not_assessed"}},
            "required": ["visibility_status"]
          },
          "then": {
            "properties": {
              "evidence_bases": {
                "not": {
                  "contains": {
                    "properties": {"kind": {"const": "human_observation"}},
                    "required": ["kind"]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
