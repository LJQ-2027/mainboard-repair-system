{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VISUAL-QC-SOURCE-PACKAGE-V2",
  "title": "Owner-managed visual QC controlled source package with source derivatives",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "batch_id",
    "source_origin",
    "physical_source_confirmed",
    "proxy_inventory_sha256",
    "board_key",
    "board_id",
    "capture_stage",
    "capture_session_id",
    "capture_setup_id",
    "capture_checklist",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": "VISUAL-QC-SOURCE-PACKAGE-V2"},
    "package_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "batch_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source_origin": {"const": "milo_supplied"},
    "physical_source_confirmed": {"const": true},
    "proxy_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "board_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "board_id": {"type": "string", "minLength": 1},
    "capture_stage": {"enum": ["golden_reference", "before_repair", "after_repair"]},
    "capture_session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "capture_setup_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "capture_checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board_and_side_confirmed", "focus_and_lens_confirmed", "lighting_and_occlusion_confirmed"],
      "properties": {
        "board_and_side_confirmed": {"const": true},
        "focus_and_lens_confirmed": {"const": true},
        "lighting_and_occlusion_confirmed": {"const": true}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "side_id",
          "original_filename",
          "object_path",
          "mime_type",
          "width",
          "height",
          "byte_size",
          "sha256",
          "source_original",
          "derivation"
        ],
        "properties": {
          "entry_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "side_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "original_filename": {"type": "string", "minLength": 1},
          "object_path": {"type": "string", "pattern": "^objects/originals/[0-9a-f]{2}/[0-9a-f]{64}\\.(jpg|png|webp)$"},
          "mime_type": {"enum": ["image/jpeg", "image/png", "image/webp"]},
          "width": {"type": "integer", "minimum": 64, "maximum": 20000},
          "height": {"type": "integer", "minimum": 64, "maximum": 20000},
          "byte_size": {"type": "integer", "minimum": 1, "maximum": 104857600},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_original": {
            "type": "object",
            "additionalProperties": false,
            "required": ["original_filename", "object_path", "mime_type", "byte_size", "sha256"],
            "properties": {
              "original_filename": {"type": "string", "minLength": 1},
              "object_path": {
                "type": "string",
                "pattern": "^objects/(originals/[0-9a-f]{2}/[0-9a-f]{64}\\.(jpg|png|webp)|source-originals/[0-9a-f]{2}/[0-9a-f]{64}\\.heic)$"
              },
              "mime_type": {"enum": ["image/jpeg", "image/png", "image/webp", "image/heic"]},
              "byte_size": {"type": "integer", "minimum": 1, "maximum": 104857600},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "derivation": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "operation",
                  "input_sha256",
                  "output_sha256",
                  "decoder",
                  "pillow_version",
                  "primary_image_selected",
                  "source_bit_depth",
                  "exif_orientation",
                  "exif_orientation_applied",
                  "metadata",
                  "output"
                ],
                "properties": {
                  "operation": {"const": "heic_primary_image_to_oriented_rgb_jpeg"},
                  "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "decoder": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "version", "libheif_version"],
                    "properties": {
                      "name": {"const": "pillow-heif"},
                      "version": {"type": "string", "minLength": 1},
                      "libheif_version": {"type": "string", "minLength": 1}
                    }
                  },
                  "pillow_version": {"type": "string", "minLength": 1},
                  "primary_image_selected": {"const": true},
                  "source_bit_depth": {"type": "integer", "minimum": 1, "maximum": 16},
                  "exif_orientation": {"type": "integer", "minimum": 0, "maximum": 8},
                  "exif_orientation_applied": {"type": "boolean"},
                  "metadata": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["exif", "icc_profile_preserved"],
                    "properties": {
                      "exif": {"const": "removed"},
                      "icc_profile_preserved": {"type": "boolean"}
                    }
                  },
                  "output": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["mime_type", "quality", "subsampling", "optimize", "progressive", "color_mode"],
                    "properties": {
                      "mime_type": {"const": "image/jpeg"},
                      "quality": {"const": 95},
                      "subsampling": {"const": 0},
                      "optimize": {"const": false},
                      "progressive": {"const": false},
                      "color_mode": {"const": "RGB"}
                    }
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source_original": {
                  "properties": {"mime_type": {"const": "image/heic"}}
                }
              }
            },
            "then": {
              "properties": {"derivation": {"type": "object"}}
            },
            "else": {
              "properties": {"derivation": {"type": "null"}}
            }
          }
        ]
      }
    }
  }
}
