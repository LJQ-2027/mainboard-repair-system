{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VISUAL-QC-LINKABLE-PHYSICAL-EVIDENCE-V1",
  "$comment": "V1 linkability is reviewed_manual_four_point only; future automatic support requires an explicit contract with equivalent auditable correspondences. This schema enforces portable structure and collection bounds only. repair_evidence_link_contract.py is authoritative for canonical hashes, strict in-memory integers, homography determinant, board-domain denominator horizon, solve correspondence, independent error recomputation, projection validity, and cross-field geometry; Draft 2020-12 may treat an in-memory mathematically integral float as an integer. Persisted JSON must enter through the strict loader, which rejects nonfinite constants and lone Unicode surrogates.",
  "title": "Visual QC Linkable Physical Evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "physical_evidence_id",
    "server_case_id",
    "intake",
    "board_key",
    "board_id",
    "side_id",
    "capture_stage",
    "evidence_role",
    "qualified_handoff",
    "qualified_handoff_sha256",
    "image_id",
    "image_sha256",
    "job_id",
    "registration_review_id",
    "registration",
    "physical_evidence_snapshot_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "VISUAL-QC-LINKABLE-PHYSICAL-EVIDENCE-V1"
    },
    "physical_evidence_id": {"$ref": "#/$defs/safeId"},
    "server_case_id": {"$ref": "#/$defs/safeId"},
    "intake": {"$ref": "#/$defs/intake"},
    "board_key": {"$ref": "#/$defs/safeId"},
    "board_id": {"$ref": "#/$defs/safeId"},
    "side_id": {"$ref": "#/$defs/safeId"},
    "capture_stage": {"$ref": "#/$defs/safeId"},
    "evidence_role": {"const": "physical_capture"},
    "qualified_handoff": {"$ref": "#/$defs/qualifiedHandoff"},
    "qualified_handoff_sha256": {"$ref": "#/$defs/sha256"},
    "image_id": {"$ref": "#/$defs/safeId"},
    "image_sha256": {"$ref": "#/$defs/sha256"},
    "job_id": {"$ref": "#/$defs/safeId"},
    "registration_review_id": {"$ref": "#/$defs/safeId"},
    "registration": {"$ref": "#/$defs/registration"},
    "physical_evidence_snapshot_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "entry_id"],
      "properties": {
        "batch_id": {"$ref": "#/$defs/safeId"},
        "entry_id": {"$ref": "#/$defs/safeId"}
      }
    },
    "qualifiedHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "handoff_schema_version",
        "source_package_manifest_sha256",
        "archived_intake_manifest_sha256",
        "acceptance_report_sha256",
        "acceptance_action",
        "registration_review_required",
        "field_accuracy_claim_allowed"
      ],
      "properties": {
        "schema_version": {
          "const": "VISUAL-QC-QUALIFIED-HANDOFF-PROVENANCE-V1"
        },
        "handoff_schema_version": {
          "const": "VISUAL-QC-PHYSICAL-HANDOFF-V1"
        },
        "source_package_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "archived_intake_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "acceptance_report_sha256": {"$ref": "#/$defs/sha256"},
        "acceptance_action": {
          "enum": [
            "automatic_candidate_review_required",
            "manual_registration_required"
          ]
        },
        "registration_review_required": {"const": true},
        "field_accuracy_claim_allowed": {"const": false}
      }
    },
    "normalizedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "registrationPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board", "image"],
      "properties": {
        "board": {"$ref": "#/$defs/normalizedPoint"},
        "image": {"$ref": "#/$defs/normalizedPoint"}
      }
    },
    "registrationError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "rms", "maximum"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "rms": {"type": "number", "minimum": 0},
        "maximum": {"type": "number", "minimum": 0}
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "board_to_image_matrix",
        "solve_anchors",
        "independent_check_points",
        "error"
      ],
      "properties": {
        "method": {
          "enum": [
            "reviewed_manual_four_point"
          ]
        },
        "board_to_image_matrix": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {"type": "number"}
        },
        "solve_anchors": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/registrationPoint"}
        },
        "independent_check_points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/registrationPoint"}
        },
        "error": {"$ref": "#/$defs/registrationError"}
      }
    }
  }
}
