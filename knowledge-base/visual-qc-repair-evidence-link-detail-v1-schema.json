{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainboard-repair.local/schemas/visual-qc-repair-evidence-link-detail-v1.json",
  "title": "Visual-QC Repair Evidence Link Detail V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "link_set_id",
    "revision",
    "manifest_sha256",
    "repair_case_id",
    "board",
    "server_case_ids",
    "counts",
    "health",
    "imported_at",
    "binding_states",
    "manifest"
  ],
  "properties": {
    "schema_version": {
      "const": "VISUAL-QC-REPAIR-EVIDENCE-LINK-DETAIL-V1"
    },
    "link_set_id": {"$ref": "#/$defs/safeId"},
    "revision": {"type": "integer", "minimum": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "repair_case_id": {"$ref": "#/$defs/safeId"},
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board_key", "board_id"],
      "properties": {
        "board_key": {"$ref": "#/$defs/safeId"},
        "board_id": {"$ref": "#/$defs/safeId"}
      }
    },
    "server_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safeId"}
    },
    "counts": {"$ref": "#/$defs/counts"},
    "health": {"$ref": "#/$defs/health"},
    "imported_at": {"type": "string", "minLength": 1},
    "binding_states": {
      "type": "array",
      "items": {"$ref": "#/$defs/bindingState"}
    },
    "manifest": {
      "type": "object",
      "required": ["schema_version", "link_set_id", "revision"],
      "properties": {
        "schema_version": {
          "const": "VISUAL-QC-REPAIR-EVIDENCE-LINK-V1"
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasons"],
      "properties": {
        "state": {"enum": ["active", "stale", "unavailable"]},
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "server_case_identity_mismatch",
              "image_identity_mismatch",
              "qualified_handoff_mismatch",
              "registration_job_mismatch",
              "registration_review_mismatch",
              "board_asset_mismatch",
              "server_case_missing",
              "image_missing",
              "registration_job_missing",
              "registration_review_missing",
              "board_asset_missing"
            ]
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "association",
        "visibility",
        "source_fact_superseded",
        "binding_superseded"
      ],
      "properties": {
        "association": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "related",
            "possibly_related",
            "not_related",
            "insufficient_evidence"
          ],
          "properties": {
            "related": {"type": "integer", "minimum": 0},
            "possibly_related": {"type": "integer", "minimum": 0},
            "not_related": {"type": "integer", "minimum": 0},
            "insufficient_evidence": {"type": "integer", "minimum": 0}
          }
        },
        "visibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["not_assessed", "visible", "not_visible", "occluded"],
          "properties": {
            "not_assessed": {"type": "integer", "minimum": 0},
            "visible": {"type": "integer", "minimum": 0},
            "not_visible": {"type": "integer", "minimum": 0},
            "occluded": {"type": "integer", "minimum": 0}
          }
        },
        "source_fact_superseded": {"type": "integer", "minimum": 0},
        "binding_superseded": {"type": "integer", "minimum": 0}
      }
    },
    "bindingState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "source_fact_superseded",
        "replacement_fact_id",
        "binding_superseded",
        "replacement_binding_id"
      ],
      "properties": {
        "binding_id": {"$ref": "#/$defs/safeId"},
        "source_fact_superseded": {"type": "boolean"},
        "replacement_fact_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/safeId"}
          ]
        },
        "binding_superseded": {"type": "boolean"},
        "replacement_binding_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/safeId"}
          ]
        }
      }
    }
  }
}
